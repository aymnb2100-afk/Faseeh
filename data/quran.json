[
 {
  "surahNumber": 78,
  "nameArabic": "النبأ",
  "nameEnglish": "An-Naba",
  "ayahs": [
   {
    "ayahNumber": 1,
    "uthmaniText": "عَمَّ يَتَسَآءَلُونَ",
    "transliteration": "'Amma yatasa'alun"
   },
   {
    "ayahNumber": 2,
    "uthmaniText": "عَنِ ٱلنَّبَإِ ٱلۡعَظِيمِ",
    "transliteration": "'Anin-naba'il-'azim"
   },
   {
    "ayahNumber": 3,
    "uthmaniText": "ٱلَّذِي هُمۡ فِيهِ مُخۡتَلِفُونَ",
    "transliteration": "Alladhi hum fihi mukhtalifun"
   },
   {
    "ayahNumber": 4,
    "uthmaniText": "كَلَّا سَيَعۡلَمُونَ",
    "transliteration": "Kalla saya'lamun"
   },
   {
    "ayahNumber": 5,
    "uthmaniText": "ثُمَّ كَلَّا سَيَعۡلَمُونَ",
    "transliteration": "Thumma kalla saya'lamun"
   },
   {
    "ayahNumber": 6,
    "uthmaniText": "أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ مِهَٰدًا",
    "transliteration": "Alam naj'alil-arda mihada"
   },
   {
    "ayahNumber": 7,
    "uthmaniText": "وَٱلۡجِبَالَ أَوۡتَادًا",
    "transliteration": "Wal-jibala awtada"
   },
   {
    "ayahNumber": 8,
    "uthmaniText": "وَخَلَقۡنَٰكُمۡ أَزۡوَٰجًا",
    "transliteration": "Wa khalaqnakum azwaja"
   },
   {
    "ayahNumber": 9,
    "uthmaniText": "وَجَعَلۡنَا نَوۡمَكُمۡ سُبَاتًا",
    "transliteration": "Wa ja'alna nawmakum subata"
   },
   {
    "ayahNumber": 10,
    "uthmaniText": "وَجَعَلۡنَا ٱلَّيۡلَ لِبَاسًا",
    "transliteration": "Wa ja'alnal-layla libasa"
   },
   {
    "ayahNumber": 11,
    "uthmaniText": "وَجَعَلۡنَا ٱلنَّهَارَ مَعَاشًا",
    "transliteration": "Wa ja'alnan-nahara ma'asha"
   },
   {
    "ayahNumber": 12,
    "uthmaniText": "وَبَنَيۡنَا فَوۡقَكُمۡ سَبۡعًا شِدَادًا",
    "transliteration": "Wa banayna fawqakum sab'an shidada"
   },
   {
    "ayahNumber": 13,
    "uthmaniText": "وَجَعَلۡنَا سِرَاجًا وَهَّاجًا",
    "transliteration": "Wa ja'alna sirajan wahhaja"
   },
   {
    "ayahNumber": 14,
    "uthmaniText": "وَأَنزَلۡنَا مِنَ ٱلۡمُعۡصِرَٰتِ مَآءً ثَجَّاجًا",
    "transliteration": "Wa anzalna minal-mu'sirati ma'an thajjaja"
   },
   {
    "ayahNumber": 15,
    "uthmaniText": "لِّنُخۡرِجَ بِهِۦ حَبًّا وَنَبَاتًا",
    "transliteration": "Linukhrija bihi habban wa nabata"
   },
   {
    "ayahNumber": 16,
    "uthmaniText": "وَجَنَّٰتٍ أَلۡفَافًا",
    "transliteration": "Wa jannatin alfafa"
   },
   {
    "ayahNumber": 17,
    "uthmaniText": "إِنَّ يَوۡمَ ٱلۡفَصۡلِ كَانَ مِيقَٰتًا",
    "transliteration": "Inna yawmal-fasli kana miqata"
   },
   {
    "ayahNumber": 18,
    "uthmaniText": "يَوۡمَ يُنفَخُ فِي ٱلصُّورِ فَتَأۡتُونَ أَفۡوَاجًا",
    "transliteration": "Yawma yunfakhu fis-suri fata'tuna afwaja"
   },
   {
    "ayahNumber": 19,
    "uthmaniText": "وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتۡ أَبۡوَٰبًا",
    "transliteration": "Wa futihatis-sama'u fakanat abwaba"
   },
   {
    "ayahNumber": 20,
    "uthmaniText": "وَسُيِّرَتِ ٱلۡجِبَالُ فَكَانَتۡ سَرَابًا",
    "transliteration": "Wa suyyiratil-jibalu fakanat saraba"
   },
   {
    "ayahNumber": 21,
    "uthmaniText": "إِنَّ جَهَنَّمَ كَانَتۡ مِرۡصَادًا",
    "transliteration": "Inna jahannama kanat mirsada"
   },
   {
    "ayahNumber": 22,
    "uthmaniText": "لِّلطَّٰغِينَ مَـَٔابًا",
    "transliteration": "Lit-taghina ma'aba"
   },
   {
    "ayahNumber": 23,
    "uthmaniText": "لَّٰبِثِينَ فِيهَآ أَحۡقَابًا",
    "transliteration": "Labithina fiha ahqaba"
   },
   {
    "ayahNumber": 24,
    "uthmaniText": "لَّا يَذُوقُونَ فِيهَا بَرۡدًا وَلَا شَرَابًا",
    "transliteration": "La yadhuquna fiha bardan wa la sharaba"
   },
   {
    "ayahNumber": 25,
    "uthmaniText": "إِلَّا حَمِيمًا وَغَسَّاقًا",
    "transliteration": "Illa hamiman wa ghassaqa"
   },
   {
    "ayahNumber": 26,
    "uthmaniText": "جَزَآءً وِفَاقًا",
    "transliteration": "Jaza'an wifaqa"
   },
   {
    "ayahNumber": 27,
    "uthmaniText": "إِنَّهُمۡ كَانُواْ لَا يَرۡجُونَ حِسَابًا",
    "transliteration": "Innahum kanu la yarjuna hisaba"
   },
   {
    "ayahNumber": 28,
    "uthmaniText": "وَكَذَّبُواْ بِـَٔايَٰتِنَا كِذَّابًا",
    "transliteration": "Wa kadhdhabu bi-ayatina kidhdhaba"
   },
   {
    "ayahNumber": 29,
    "uthmaniText": "وَكُلَّ شَيۡءٍ أَحۡصَيۡنَٰهُ كِتَٰبًا",
    "transliteration": "Wa kulla shay'in ahsaynahu kitaba"
   },
   {
    "ayahNumber": 30,
    "uthmaniText": "فَذُوقُواْ فَلَن نَّزِيدَكُمۡ إِلَّا عَذَابًا",
    "transliteration": "Fadhuqu falan nazidakum illa 'adhaba"
   },
   {
    "ayahNumber": 31,
    "uthmaniText": "إِنَّ لِلۡمُتَّقِينَ مَفَازًا",
    "transliteration": "Inna lil-muttaqina mafaza"
   },
   {
    "ayahNumber": 32,
    "uthmaniText": "حَدَآئِقَ وَأَعۡنَٰبًا",
    "transliteration": "Hada'iqa wa a'naba"
   },
   {
    "ayahNumber": 33,
    "uthmaniText": "وَكَوَاعِبَ أَتۡرَابًا",
    "transliteration": "Wa kawa'iba atraba"
   },
   {
    "ayahNumber": 34,
    "uthmaniText": "وَكَأۡسًا دِهَاقًا",
    "transliteration": "Wa ka'san dihaqa"
   },
   {
    "ayahNumber": 35,
    "uthmaniText": "لَّا يَسۡمَعُونَ فِيهَا لَغۡوًا وَلَا كِذَّٰبًا",
    "transliteration": "La yasma'una fiha laghwan wa la kidhdhaba"
   },
   {
    "ayahNumber": 36,
    "uthmaniText": "جَزَآءً مِّن رَّبِّكَ عَطَآءً حِسَابًا",
    "transliteration": "Jaza'an min rabbika 'ata'an hisaba"
   },
   {
    "ayahNumber": 37,
    "uthmaniText": "رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا ٱلرَّحۡمَٰنِۖ لَا يَمۡلِكُونَ مِنۡهُ خِطَابًا",
    "transliteration": "Rabbis-samawati wal-ardi wa ma baynahumar-rahmani la yamlikuna minhu khitaba"
   },
   {
    "ayahNumber": 38,
    "uthmaniText": "يَوۡمَ يَقُومُ ٱلرُّوحُ وَٱلۡمَلَٰٓئِكَةُ صَفًّاۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنۡ أَذِنَ لَهُ ٱلرَّحۡمَٰنُ وَقَالَ صَوَابًا",
    "transliteration": "Yawma yaqumur-ruhu wal-mala'ikatu saffan la yatakallamuna illa man adhina lahur-rahmanu wa qala sawaba"
   },
   {
    "ayahNumber": 39,
    "uthmaniText": "ذَٰلِكَ ٱلۡيَوۡمُ ٱلۡحَقُّۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا",
    "transliteration": "Dhalikal-yawmul-haqq, faman sha'at-takhadha ila rabbihi ma'aba"
   },
   {
    "ayahNumber": 40,
    "uthmaniText": "إِنَّآ أَنذَرۡنَٰكُمۡ عَذَابًا قَرِيبًا يَوۡمَ يَنظُرُ ٱلۡمَرۡءُ مَا قَدَّمَتۡ يَدَاهُ وَيَقُولُ ٱلۡكَافِرُ يَٰلَيۡتَنِي كُنتُ تُرَٰبَۢا",
    "transliteration": "Inna andharnakum 'adhaban qariban yawma yanzurul-mar'u ma qaddamat yadahu wa yaqulul-kafiru ya laytani kuntu turaba"
   }
  ]
 },
 {
  "surahNumber": 80,
  "nameArabic": "عبس",
  "nameEnglish": "Abasa",
  "ayahs": [
   {
    "ayahNumber": 1,
    "uthmaniText": "عَبَسَ وَتَوَلَّىٰٓ",
    "transliteration": "'Abasa wa tawalla"
   },
   {
    "ayahNumber": 2,
    "uthmaniText": "أَن جَآءَهُ ٱلۡأَعۡمَىٰ",
    "transliteration": "An ja'ahul-a'ma"
   },
   {
    "ayahNumber": 3,
    "uthmaniText": "وَمَا يُدۡرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ",
    "transliteration": "Wa ma yudrika la'allahu yazzakka"
   },
   {
    "ayahNumber": 4,
    "uthmaniText": "أَوۡ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكۡرَىٰٓ",
    "transliteration": "Aw yadhdhakkaru fatanfa'ahudh-dhikra"
   },
   {
    "ayahNumber": 5,
    "uthmaniText": "أَمَّا مَنِ ٱسۡتَغۡنَىٰ",
    "transliteration": "Amma manis-taghna"
   },
   {
    "ayahNumber": 6,
    "uthmaniText": "فَأَنتَ لَهُۥ تَصَدَّىٰ",
    "transliteration": "Fa-anta lahu tasadda"
   },
   {
    "ayahNumber": 7,
    "uthmaniText": "وَمَا عَلَيۡكَ أَلَّا يَزَّكَّىٰ",
    "transliteration": "Wa ma 'alayka alla yazzakka"
   },
   {
    "ayahNumber": 8,
    "uthmaniText": "وَأَمَّا مَن جَآءَكَ يَسۡعَىٰ",
    "transliteration": "Wa amma man ja'aka yas'a"
   },
   {
    "ayahNumber": 9,
    "uthmaniText": "وَهُوَ يَخۡشَىٰ",
    "transliteration": "Wa huwa yakhsha"
   },
   {
    "ayahNumber": 10,
    "uthmaniText": "فَأَنتَ عَنۡهُ تَلَهَّىٰ",
    "transliteration": "Fa-anta 'anhu talahha"
   },
   {
    "ayahNumber": 11,
    "uthmaniText": "كَلَّآ إِنَّهَا تَذۡكِرَةٌ‏",
    "transliteration": "Kalla innaha tadhkira"
   },
   {
    "ayahNumber": 12,
    "uthmaniText": "فَمَن شَآءَ ذَكَرَهُۥ",
    "transliteration": "Faman sha'a dhakarah"
   },
   {
    "ayahNumber": 13,
    "uthmaniText": "فِي صُحُفٍ مُّكَرَّمَةٍ‏",
    "transliteration": "Fi suhufin mukarrama"
   },
   {
    "ayahNumber": 14,
    "uthmaniText": "مَّرۡفُوعَةٍ مُّطَهَّرَةِۭ",
    "transliteration": "Marfu'atin mutahhara"
   },
   {
    "ayahNumber": 15,
    "uthmaniText": "بِأَيۡدِي سَفَرَةٍ‏",
    "transliteration": "Bi-aydi safara"
   },
   {
    "ayahNumber": 16,
    "uthmaniText": "كِرَامِۭ بَرَرَةٍ‏",
    "transliteration": "Kiramin barara"
   },
   {
    "ayahNumber": 17,
    "uthmaniText": "قُتِلَ ٱلۡإِنسَٰنُ مَآ أَكۡفَرَهُۥ",
    "transliteration": "Qutilal-insanu ma akfarah"
   },
   {
    "ayahNumber": 18,
    "uthmaniText": "مِنۡ أَيِّ شَيۡءٍ خَلَقَهُۥ",
    "transliteration": "Min ayyi shay'in khalaqah"
   },
   {
    "ayahNumber": 19,
    "uthmaniText": "مِن نُّطۡفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ",
    "transliteration": "Min nutfatin khalaqahu faqaddarah"
   },
   {
    "ayahNumber": 20,
    "uthmaniText": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ",
    "transliteration": "Thummas-sabila yassarah"
   },
   {
    "ayahNumber": 21,
    "uthmaniText": "ثُمَّ أَمَاتَهُۥ فَأَقۡبَرَهُۥ",
    "transliteration": "Thumma amatahu fa-aqbarah"
   },
   {
    "ayahNumber": 22,
    "uthmaniText": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ",
    "transliteration": "Thumma idha sha'a ansharah"
   },
   {
    "ayahNumber": 23,
    "uthmaniText": "كَلَّا لَمَّا يَقۡضِ مَآ أَمَرَهُۥ",
    "transliteration": "Kalla lamma yaqdi ma amarah"
   },
   {
    "ayahNumber": 24,
    "uthmaniText": "فَلۡيَنظُرِ ٱلۡإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ",
    "transliteration": "Falyanzuril-insanu ila ta'amih"
   },
   {
    "ayahNumber": 25,
    "uthmaniText": "أَنَّا صَبَبۡنَا ٱلۡمَآءَ صَبًّا",
    "transliteration": "Anna sababnal-ma'a sabba"
   },
   {
    "ayahNumber": 26,
    "uthmaniText": "ثُمَّ شَقَقۡنَا ٱلۡأَرۡضَ شَقًّا",
    "transliteration": "Thumma shaqaqnal-arda shaqqa"
   },
   {
    "ayahNumber": 27,
    "uthmaniText": "فَأَنۢبَتۡنَا فِيهَا حَبًّا",
    "transliteration": "Fa-anbatna fiha habba"
   },
   {
    "ayahNumber": 28,
    "uthmaniText": "وَعِنَبًا وَقَضۡبًا",
    "transliteration": "Wa 'inaban wa qadba"
   },
   {
    "ayahNumber": 29,
    "uthmaniText": "وَزَيۡتُونًا وَنَخۡلًا",
    "transliteration": "Wa zaytunan wa nakhla"
   },
   {
    "ayahNumber": 30,
    "uthmaniText": "وَحَدَآئِقَ غُلۡبًا",
    "transliteration": "Wa hada'iqa ghulba"
   },
   {
    "ayahNumber": 31,
    "uthmaniText": "وَفَٰكِهَةً وَأَبًّا",
    "transliteration": "Wa fakihatan wa abba"
   },
   {
    "ayahNumber": 32,
    "uthmaniText": "مَّتَٰعًا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ",
    "transliteration": "Mata'an lakum wa li-an'amikum"
   },
   {
    "ayahNumber": 33,
    "uthmaniText": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ",
    "transliteration": "Fa-idha ja'atis-sakhkha"
   },
   {
    "ayahNumber": 34,
    "uthmaniText": "يَوۡمَ يَفِرُّ ٱلۡمَرۡءُ مِنۡ أَخِيهِ",
    "transliteration": "Yawma yafirrul-mar'u min akhih"
   },
   {
    "ayahNumber": 35,
    "uthmaniText": "وَأُمِّهِۦ وَأَبِيهِ",
    "transliteration": "Wa ummihi wa abih"
   },
   {
    "ayahNumber": 36,
    "uthmaniText": "وَصَٰحِبَتِهِۦ وَبَنِيهِ",
    "transliteration": "Wa sahibatihi wa banih"
   },
   {
    "ayahNumber": 37,
    "uthmaniText": "لِكُلِّ ٱمۡرِيٍٕ مِّنۡهُمۡ يَوۡمَئِذٍ شَأۡنٌ يُغۡنِيهِ",
    "transliteration": "Likullim-ri'im minhum yawma'idhin sha'nun yughnih"
   },
   {
    "ayahNumber": 38,
    "uthmaniText": "وُجُوهٌ يَوۡمَئِذٍ مُّسۡفِرَةٌ‏",
    "transliteration": "Wujuhun yawma'idhin musfira"
   },
   {
    "ayahNumber": 39,
    "uthmaniText": "ضَاحِكَةٌ مُّسۡتَبۡشِرَةٌ‏",
    "transliteration": "Dahikatun mustabshira"
   },
   {
    "ayahNumber": 40,
    "uthmaniText": "وَوُجُوهٌ يَوۡمَئِذٍ عَلَيۡهَا غَبَرَةٌ‏",
    "transliteration": "Wa wujuhun yawma'idhin 'alayha ghabara"
   },
   {
    "ayahNumber": 41,
    "uthmaniText": "تَرۡهَقُهَا قَتَرَةٌ",
    "transliteration": "Tarhaquha qatara"
   },
   {
    "ayahNumber": 42,
    "uthmaniText": "أُوْلَٰٓئِكَ هُمُ ٱلۡكَفَرَةُ ٱلۡفَجَرَةُ",
    "transliteration": "Ula'ika humul-kafaratul-fajara"
   }
  ]
 },
 {
  "surahNumber": 103,
  "nameArabic": "العصر",
  "nameEnglish": "Al-Asr",
  "ayahs": [
   {
    "ayahNumber": 1,
    "uthmaniText": "وَٱلۡعَصۡرِ",
    "transliteration": "Wal-'asr"
   },
   {
    "ayahNumber": 2,
    "uthmaniText": "إِنَّ ٱلۡإِنسَٰنَ لَفِي خُسۡرٍ",
    "transliteration": "Innal-insana lafi khusr"
   },
   {
    "ayahNumber": 3,
    "uthmaniText": "إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ وَتَوَاصَوۡاْ بِٱلۡحَقِّ وَتَوَاصَوۡاْ بِٱلصَّبۡرِ",
    "transliteration": "Illal-ladhina amanu wa 'amilus-salihati wa tawasaw bil-haqqi wa tawasaw bis-sabr"
   }
  ]
 },
 {
  "surahNumber": 108,
  "nameArabic": "الكوثر",
  "nameEnglish": "Al-Kawthar",
  "ayahs": [
   {
    "ayahNumber": 1,
    "uthmaniText": "إِنَّآ أَعۡطَيۡنَٰكَ ٱلۡكَوۡثَرَ",
    "transliteration": "Inna a'taynaka al-kawthar"
   },
   {
    "ayahNumber": 2,
    "uthmaniText": "فَصَلِّ لِرَبِّكَ وَٱنۡحَرۡ",
    "transliteration": "Fasalli li-rabbika wanhar"
   },
